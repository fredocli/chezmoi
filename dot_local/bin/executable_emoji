#!/bin/bash

APP=$(basename "$0")
EMOJI_FILE="$HOME/.config/emoji/emoji.txt"


usage() {
if [[ -n "${WAYLAND_DISPLAY:-}" || "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
	command -v wtype >/dev/null || { echo "wtype is required for typing in Wayland" >&2; return 1; } 
	command -v wl-copy >/dev/null || { echo "wl-copy is required for Wayland clipboard access" >&2; return 1; }
else
	command -v xdotool >/dev/null || { echo "xdotool is required for typing in Xorg" >&2; return 1; }
	command -v xsel >/dev/null || { echo "xsel is required for Xorg clipboard access" >&2; return 1; }
fi
cat >&2 <<EOF
Usage: $APP [-q query] [-p] [-h]

Requirements:
	Common: rofi, notify-send, and $EMOJI_FILE
	Wayland: wl-copy and wtype
	Xorg:    xsel and xdotool		
EOF
exit 0
}

function show_emoji(){

rofi  -show -dmenu -input $EMOJI_FILE \
-filter "$QUERY" \
-font "mono 24" \
-multi-select \
-mesg "Alt+edit - Alt+print" \
-p "EMOJI" \
-width 40 \
-format "s" \
-kb-element-next "" \
-kb-accept-alt  "Tab" \
-kb-custom-1 "Alt+p" \
-kb-custom-2 "Alt+e" 
}

copy_emoji() {
	if [[ -n "${WAYLAND_DISPLAY:-}" || "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
		printf '%s' "$1" | wl-copy
	else
		printf '%s' "$1" | xsel -b
	fi
}

type_emoji() {
	if [[ -n "${WAYLAND_DISPLAY:-}" || "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
	
		wtype -d 48 "$1"
	else
		xdotool type --clearmodifiers --delay 48 "$1"
	fi
}

QUERY=""
PRINT=0
CLIPBOARD=0

while getopts "q:ph" option
do
	case "$option" in
	  h )	usage ;;
	  p )	PRINT=1 ;;
	  q )	QUERY="$OPTARG" ;;
	  ? )    usage ;;
  esac
done

shift $(($OPTIND - 1))


value="$(show_emoji)"
key="$?"

if [ "$key" -eq "11" ] 
then
$EDIT "$EMOJI_FILE" & 
exit
fi


if [ -n "$value" ] 
then   

    value=$(echo  "$value" |awk 'BEGIN{ORS=""; OFS="\t"} {print $1}'  ) 
    echo  "value: $value    key: $key"

    if [ "$key" -eq "10" ] || [ "$PRINT" -eq 1 ]
    then
	copy_emoji "$value" || exit 1
	sleep 0.5
	notify-send "'$value'" &
	type_emoji "$value" || exit 1
    else
	copy_emoji "$value" || exit 1
	notify-send "'$value' cliped!" &
    fi    
fi