#!/bin/sh
# ~/.local/bin/cal-toggle
id=$(niri msg -j windows | jq -r '.[] | select(.app_id=="cal") | .id')
if [ -n "$id" ]; then
  niri msg action close-window --id "$id"
else
  exec alacritty --title calendar --class cal -e sh -c 'cal -3 --color=always | sed "s/\x1b\[7m/\x1b[1;4;38;2;255;204;102m/; s/\x1b\[27m/\x1b[0m/"; read -r _'
fi