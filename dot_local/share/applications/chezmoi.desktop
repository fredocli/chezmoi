[Desktop Entry]
Version=1.0
Type=Application
Name=chezmoi
Comment=chezmoi + fzf
Exec=bash -c ". ~/.fzfrc; exec cmf"
Icon=home
Terminal=true
Categories=Utility;ConsoleOnly;
Keywords=#chezmoi;#repo;#fzf;#cm
Actions=Desktop;

[Desktop Action Desktop]
Name=edit Desktop files
Exec=bash -c ". ~/.fzfrc; exec cmf desktop"
