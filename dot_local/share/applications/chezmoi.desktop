[Desktop Entry]
Version=1.0
Type=Application
Name=chezmoi (cm)
Comment=chezmoi + fzf
Exec=bash -c ". ~/.fzfrc; exec cmf"
Icon=home
Terminal=true
Categories=Utility;ConsoleOnly;
Keywords=#fredo;#repo;#chezmoi;#fzf;#cm
