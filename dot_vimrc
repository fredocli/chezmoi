" ================ CLEAN ===========================

function! CLEAN()
    " Remove multiple spaces
    execute ':%s/^\s\+//gc'
    " Reduce multiple line breaks to 2 lines
    execute ':%s/\n\{3,\}/\r\r/gc'
endfunction
command! -nargs=* -bang CLEAN call CLEAN()

function! CLEANN()
   " Add 1 ligne under and over H1-H6 
   execute ':%s/^#\{1,6} \(.*\)/\r\0\r/g'
    " Replace tab by 2 Spaces
    execute ':%s/\t/ /g'
    " Remove multiple spaces 
    execute ':%s/^\s\+//g'
    execute ':%s/\s\{2,\}/ /g'
    " Reduce multiple line breaks to 2 lines 
    execute ':%s/\n\{3,\}/\r\r/g'
    " Replace text
    execute ':%s/\<ca\./>/cirka/gc'
    execute ':%s/\<evt\./>/eventuelt/gc'
    execute ':%s/º/°/g'
    " remove useless space  
    execute ':%s/\. $/./g'
    execute ':%s/^---\s\{1,}$/---/g'
    " format ingredients list
    execute ':%s/^\([0-9.,]\{1,4} \)/- \1/gc'
    execute ':%s/ $//g'
    " Remove empty lines at the end of the document
    execute ':%s/\($\n\s*\)\+\%$//'
    " Remove empty lines at the beginning  of the document
    execute ':%s/\%^\s*\n//gc'

endfunction
command! -nargs=* -bang CLEANN call CLEANN()
command! -nargs=* -bang CLEAN  call CLEAN()
" ================ REtemplate ===========================

function! REtemplate()
    let save_cursor = getpos(".")
    let s:lang=&spelllang
    let s:file=expand('%:p')
    echom s:file 
    execute ':w'
    normal! ggVGd
    call system('retemplate -i '.s:file.' -l '.s:lang) 
    execute ':0r /tmp/retemplate'
    silent! %s#\($\n\s*\)\+\%$##
    call setpos('.', save_cursor)
endfunction

command! -nargs=* -bang REtemplate call REtemplate()

