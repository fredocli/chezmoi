" heading
function! MarkdownHeading(level)
    let s:firstChar = getline('.')[0] 
      if a:level == 1
	  if s:firstChar == "#"
	    normal! 0cw#
	  else
	    normal! I# 
	  endif		
	  normal! gUU
      elseif a:level == 2
	  if s:firstChar == "#"
	    normal! 0cw##
	  else
	    normal! I## 
	  endif		
	  normal! gUU
      elseif a:level == 3 
	  if s:firstChar == "#"
	    normal! 0cw###
	  else
	    normal! I### 
	  endif		
	  normal! guu
      else
	  if s:firstChar == "#"
	    normal! 0cw####
	  else
	    normal! I#### 
	  endif		
	  normal! guu
      endif
endfunction

