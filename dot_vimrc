function! BuffersGrep(pattern)
  call ClearQuickfixList()
  exe 'bufdo vimgrepadd ' . a:pattern . ' %'
  cnext
endfunction
command! -nargs=1 Vim call BufferGrep(<f-args>)
command! -nargs=1 BuffersGrep call BuffersGrep(<f-args>)

