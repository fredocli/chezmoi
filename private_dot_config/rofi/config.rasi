

configuration {

//cache-dir:"./.config/rofi/";
show: "drun";


modi: "window,run,drun,filebrowser,ssh,keys";
width: 40;
lines: 20;
cycle: false;



// HISTORY
disable-history: false;
max-history-size: 2000;


// shell command rofi -show drun
run-shell-command: "{terminal} -e {cmd}";

// rofi -show run (ajoute 2 commandes a la liste de run)
drun-list-command: "echo \"cmd1 param1\ncmd2 param2\""; // ajouter 2 comande a la liste 

// for debug
//run-command: "notify-send debug '{cmd}'";

display-run: "run: ";

show-icons: true;

// DRUN



//drun-use-desktop-cache: true;

//prompt
display-drun: "drun: ";

// format
drun-display-format: " {name}: {generic} [<span color=\"#828A99\"> {keywords}</span>] {generic}";

// show action
drun-show-actions: true;

//drun-categories category1,category2
//Only show desktop files that are present in the listed categories.

//drun-exclude-categories category1,category2
//Exclude desktop files that are present in the listed categories.

//Default: name,generic,exec,categories,
drun-match-fields: "name,keywords";



// cancel
kb-cancel: "Escape";

// delete-entry
kb-delete-entry: "Control+Delete"; //Delete entry from history.

// line
kb-clear-line: "ctrl+BackSpace";

// mode
kb-mode-next: "Shift+Right,Control+Tab";
kb-mode-previous: "Shift+Left,Control+ISO_Left_Tab";

kb-move-char-back: "Left";
kb-move-char-forward: "Right";
kb-move-word-back: "Alt+Left";
kb-move-word-forward: "Alt+Right";

// paste
kb-primary-paste: "Control+v";

kb-remove-char-back: "BackSpace";
kb-remove-char-forward: "Delete";
kb-remove-word-back: "Control+Left";
kb-remove-word-forward: "Control+Right";
//kb-row-first: "Control+Up";
//kb-row-last: "Control+Down";
//kb-row-select: "Tab";
//kb-row-tab: "";
kb-secondary-paste: "Control+V";

//case
kb-toggle-case-sensitivity: "Control+i";
kb-toggle-case-sensitivity: "plus";

// sort
kb-toggle-sort: "Control+s";
}


// Theme
@theme "~/.config/rofi/Dracula.rasi" 