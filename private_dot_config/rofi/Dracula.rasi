* {
    default-background: #222222;
    default-foreground: #ebebd4;
    default-border: #668800;
    invisible: #00000000;
    hard-grey: #101010;
    hard-red: #A51D2D;
    light-red: #F66151;
    light-green: #50FA7B;
    purple: #DC8ADD;
    background-color: @invisible;
    border-color: @default-border;
    text-color: @default-foreground;
}

#window {
    background-color: @default-background;
    border: 1;
    border-radius: 3;
    border-color: @default-border;
    padding: 10;
}

#mainbox {
    border: 0;
    padding: 0;
}

#message {
    border: 0;
    border-radius: 3;
    padding: 5;
    background-color: @default-background;
}

#textbox {
    background-color: @hard-grey;
}

#listview {
    fixed-height: 0;
    spacing: 2;
    scrollbar: false;
    padding: 2 0 0;
}

#element {
    padding: 5;
    border: 0;
    border-radius: 3;
    border-color: @invisible;
}

#element.normal.normal {
    background-color: @invisible;
}

#element.normal.urgent {
    background-color: @light-red;
}

#element.normal.active {
    border-color: @default-background;
}

#element.selected.normal {
    background-color: black;
}

#element-text.selected {
    text-color: yellow;
}

#element.selected.urgent {
    background-color: @light-red;
    border-color: @hard-red;
}

#element.selected.active {
    background-color: @light-green;
    border-color: @default-background;
    color: @default-background;
}

#mode-switcher {
    spacing: 0;
}

#button {
    border: 0;
    border-color: @invisible;
    padding: 3;
}

#button.selected {
    border-color: @purple;
}

#inputbar {
    spacing: 0;
    padding: 1;
}

#case-indicator {
    spacing: 0;
    padding: 3px;
    background-color: @default-background;
    border: 0;
    border-radius: 0 2 2 0;
}

#entry {
    background-color: @default-background;
    padding: 3px;
    border: 0;
    border-radius: 2 0 0 2;
}

#prompt {
    padding: 3 7 3 0;
}
