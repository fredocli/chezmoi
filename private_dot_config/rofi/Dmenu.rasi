/**
 * ROFI Color theme
 * NAME: dt-dmenu.rasi
 * DESCRIPTION: This is a horizontal prompt similar to dmenu.
 * AUTHOR: Derek Taylor (DT)
 */

* {
    background-color:           #282c34;
    border-color:               #282c34;
    text-color:                 #ffffff;
    height:                     36px;
    font:                       "Ubuntu bold 13";
    prompt-font:                "Ubuntu  bold 12";
    prompt-background:          #668800;
    prompt-foreground:          #282c34;
    prompt-padding:             6px;
    selected-normal-background: #282c34;
    selected-normal-foreground: #eafa07;
}
#window {
    anchor: northwest;
    location: northwest;
    x-offset: 0px;
    y-offset: -36px;
    width: 100%;
    padding: 0px;
    children: [ horibox ];
}
#horibox {
    orientation: horizontal;
    children: [ prompt, entry, listview ];
    
}
#prompt {
    padding:          @prompt-padding;
    background-color: @prompt-background;
    text-color:       @prompt-foreground;
    font:             @prompt-font;
}
#listview {
    layout: horizontal;
    lines: 100;
}
#entry {
    padding: 2px;
    expand: false;
    width: 10em;
 }
#element {
    padding: 6px 6px;
    // background-color:red;
    height:inherit;
}
#element selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}

